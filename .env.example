# 复制为 .env 后按需修改

# 推理模式: auto | remote | local | mock
INFERENCE_MODE=auto

# 远程 GPU 推理服务器（局域网 TimesFM 机器）
TIMESFM_SSH_HOST=192.168.0.109
TIMESFM_SSH_PORT=22
TIMESFM_SSH_USER=root
# 本机 SSH 私钥所在目录（挂载进容器，容器内读取 id_ed25519）
# TIMESFM_SSH_DIR=~/.ssh

# GPU 服务器上 worker 目录与 Python 解释器
# TIMESFM_REMOTE_DIR=/data/work/timesfm-3/stock_worker
# TIMESFM_REMOTE_PYTHON=/data/work/timesfm-3/.venv/bin/python

# 本地历史K线仓库（通达信式"先下载数据、本地选股"）
# baostock 多进程并发数（过大易被数据源限流）
# SYNC_WORKERS=4
# 可选：通达信 PC 客户端 vipdoc 目录（如 C:\new_tdx\vipdoc）。
# 设置后同步时优先读取其本地 .day 日K文件（注意：不复权），缺口再用 baostock 补齐
# TDX_VIPDOC_PATH=
